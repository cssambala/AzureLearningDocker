@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <h2 class="mb-4 text-center">
                        <i class="bi bi-box-arrow-in-right"></i> Login to Your Account
                    </h2>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="your@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="bi bi-check-circle"></i> Login
                        </button>
                    </form>

                    <hr class="my-4" />

                    @if (Model.ExternalLogins?.Any() == true)
                    {
                        <p class="text-center text-muted mb-3">Or login with:</p>

                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <form asp-action="ExternalLogin" asp-route-provider="@provider.Name" method="post" class="mb-2">
                                <button type="submit" class="btn btn-outline-secondary w-100">
                                    @if (provider.Name == "Google")
                                    {
                                        @:<i class="bi bi-google"></i> Login with Google
                                    }
                                    else if (provider.Name == "Microsoft")
                                    {
                                        @:<i class="bi bi-microsoft"></i> Login with Microsoft
                                    }
                                    else
                                    {
                                        @:Login with @provider.DisplayName
                                    }
                                </button>
                            </form>
                        }

                        <hr class="my-4" />
                    }

                    <p class="text-center">
                        Don't have an account?
                        <a asp-action="Register" class="fw-bold text-decoration-none">Create one now</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .form-control-lg {
        border-radius: 8px;
        padding: 12px 15px;
    }

    .btn-lg {
        border-radius: 8px;
        padding: 12px 15px;
        font-weight: 600;
    }
</style>
