@model RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <h2 class="mb-4 text-center">
                        <i class="bi bi-person-plus"></i> Create Your Account
                    </h2>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control form-control-lg" placeholder="John" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control form-control-lg" placeholder="Doe" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="your@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Enter password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <small class="form-text text-muted d-block mt-2">
                                Password must be at least 6 characters, contain uppercase, lowercase, and numbers.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Confirm password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="bi bi-person-check"></i> Create Account
                        </button>
                    </form>

                    <p class="text-center">
                        Already have an account?
                        <a asp-action="Login" class="fw-bold text-decoration-none">Login here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .form-control-lg {
        border-radius: 8px;
        padding: 12px 15px;
    }

    .btn-lg {
        border-radius: 8px;
        padding: 12px 15px;
        font-weight: 600;
    }
</style>
