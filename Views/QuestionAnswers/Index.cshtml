@model IEnumerable<AzureLearningDocker.Models.QuestionAnswer>

@{
    ViewData["Title"] = "Question & Answers";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Question & Answers</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Q&A
            </a>
        </div>
    </div>

    @if (Model.Count() == 0)
    {
        <div class="alert alert-info">
            No Q&A found. <a asp-action="Create">Create one</a> to get started.
        </div>
    }
    else
    {
        <div class="accordion" id="qaAccordion">
            @{
                int index = 0;
            }
            @foreach (var qa in Model)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="qaHeading@index">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#qaCollapse@index" aria-expanded="false" aria-controls="qaCollapse@index">
                            <strong>Q@(index + 1):</strong> @qa.Question
                        </button>
                    </h2>
                    <div id="qaCollapse@index" class="accordion-collapse collapse" aria-labelledby="qaHeading@index" data-bs-parent="#qaAccordion">
                        <div class="accordion-body">
                            <p>@qa.Answer</p>
                            <small class="text-muted">Chapter: @qa.Chapter?.Title</small>
                            <div class="btn-group btn-group-sm float-end" role="group">
                                <a asp-action="Details" asp-route-id="@qa.Id" class="btn btn-info">View</a>
                                <a asp-action="Edit" asp-route-id="@qa.Id" class="btn btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@qa.Id" class="btn btn-danger">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
                index++;
            }
        </div>
    }
</div>
