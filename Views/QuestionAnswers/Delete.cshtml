@model AzureLearningDocker.Models.QuestionAnswer

@{
    ViewData["Title"] = "Delete Question & Answer";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Delete Question & Answer</h4>
                <p>Are you sure you want to delete this Q&A? This action cannot be undone.</p>
            </div>

            <h3>Q: @Model.Question</h3>
            <p>A: @Model.Answer</p>
            <p class="text-muted">Chapter: @Model.Chapter?.Title</p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
