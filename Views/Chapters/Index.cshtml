@model IEnumerable<AzureLearningDocker.Models.Chapter>

@{
    ViewData["Title"] = "Chapters";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Chapters</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Chapter
            </a>
        </div>
    </div>

    @if (Model.Count() == 0)
    {
        <div class="alert alert-info">
            No chapters found. <a asp-action="Create">Create one</a> to get started.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Day</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Topics</th>
                        <th>Q&A</th>
                        <th>PDFs</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var chapter in Model.OrderBy(c => c.DayNumber))
                    {
                        <tr>
                            <td><strong>Day @chapter.DayNumber</strong></td>
                            <td>@chapter.Title</td>
                            <td>@chapter.Category?.Name</td>
                            <td><span class="badge bg-info">@chapter.Topics.Count</span></td>
                            <td><span class="badge bg-warning text-dark">@chapter.QuestionAnswers.Count</span></td>
                            <td><span class="badge bg-success">@chapter.PdfAttachments.Count</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@chapter.Id" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@chapter.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@chapter.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
