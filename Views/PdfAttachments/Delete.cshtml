@model AzureLearningDocker.Models.PdfAttachment

@{
    ViewData["Title"] = "Delete PDF";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Delete PDF</h4>
                <p>Are you sure you want to delete this PDF? This action cannot be undone and the file will be permanently removed.</p>
            </div>

            <h3><i class="bi bi-file-pdf text-danger"></i> @Model.FileName</h3>
            <p class="text-muted">Chapter: @Model.Chapter?.Title</p>
            <p class="text-muted">Size: @(Model.FileSizeInBytes / 1024.0).ToString("F2") KB</p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
