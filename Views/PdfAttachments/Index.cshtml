@model IEnumerable<AzureLearningDocker.Models.PdfAttachment>

@{
    ViewData["Title"] = "PDF Attachments";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>PDF Resources</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Upload PDF
            </a>
        </div>
    </div>

    @if (Model.Count() == 0)
    {
        <div class="alert alert-info">
            No PDFs found. <a asp-action="Create">Upload one</a> to get started.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var pdf in Model)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="mb-1"><i class="bi bi-file-pdf text-danger"></i> @pdf.FileName</h5>
                            <p class="mb-1 text-muted">Chapter: @pdf.Chapter?.Title</p>
                            <p class="mb-1 text-muted">Size: @(pdf.FileSizeInBytes / 1024.0).ToString("F2") KB</p>
                            <small class="text-muted">Uploaded: @pdf.CreatedDate.ToShortDateString()</small>
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="@pdf.FileUrl" class="btn btn-success" target="_blank">
                                <i class="bi bi-download"></i> Download
                            </a>
                            <a asp-action="Delete" asp-route-id="@pdf.Id" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
