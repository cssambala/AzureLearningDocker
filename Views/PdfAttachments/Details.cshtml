@model AzureLearningDocker.Models.PdfAttachment

@{
    ViewData["Title"] = "PDF Details";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="mb-4">
                <h1><i class="bi bi-file-pdf text-danger"></i> @Model.FileName</h1>
                <p class="text-muted">Chapter: <strong>@Model.Chapter?.Title</strong></p>
                <a asp-controller="Chapters" asp-action="Details" asp-route-id="@Model.ChapterId" class="btn btn-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back to Chapter
                </a>
            </div>

            <div class="card">
                <div class="card-body">
                    <p><strong>File Name:</strong> @Model.FileName</p>
                    <p><strong>File Size:</strong> @(Model.FileSizeInBytes / 1024.0).ToString("F2") KB</p>
                    <p><strong>Uploaded:</strong> @Model.CreatedDate.ToString("g")</p>
                </div>
            </div>

            <div class="mt-3">
                <a href="@Model.FileUrl" class="btn btn-success" target="_blank">
                    <i class="bi bi-download"></i> Download
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </a>
            </div>
        </div>
    </div>
</div>
